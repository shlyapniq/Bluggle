<Window x:Class="Bluggle.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bluggle"
        Width="64" Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ToolTipService.InitialShowDelay="400"
        ToolTipService.ShowDuration="8000">

    <Window.Resources>
        <!--
            Storyboards live here rather than in code so the timings are all in one readable
            place. They are started with Begin(this, true) so they stay controllable and can be
            stopped again when the transient state ends.
        -->
        <Storyboard x:Key="BusySpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="BusyRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.1" />
        </Storyboard>

        <Storyboard x:Key="BusyPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="IconHost"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.45" Duration="0:0:0.62">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Background="Transparent" (not null) so the full square stays hit-testable and easy
         to grab when dragging, even outside the visible circle. -->
    <Grid x:Name="RootScale" Background="Transparent" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Viewbox Stretch="Uniform">
            <!-- Fixed 64-unit design surface; the Viewbox scales it to whatever WidgetSize says. -->
            <Grid Width="64" Height="64" Background="Transparent">

                <Border x:Name="Chip"
                        Width="54" Height="54" CornerRadius="27"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <!-- ShadowDepth 0 turns a drop shadow into a glow. -->
                        <DropShadowEffect x:Name="ChipGlow" ShadowDepth="0" BlurRadius="16" Opacity="0" />
                    </Border.Effect>
                </Border>

                <!-- Busy ring: a mostly-dashed-away circle, so one short arc chases around the
                     chip. StrokeDashArray is in multiples of StrokeThickness. -->
                <Ellipse x:Name="BusyRing"
                         Width="46" Height="46"
                         StrokeThickness="3"
                         StrokeDashArray="4 40"
                         StrokeDashCap="Round"
                         Opacity="0"
                         IsHitTestVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="BusyRotate" Angle="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Canvas x:Name="IconHost"
                        Width="24" Height="24"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path x:Name="Band"
                          Data="{StaticResource HeadphoneBand}"
                          StrokeThickness="2.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <Path x:Name="CupLeft"
                          Data="{StaticResource HeadphoneCupLeft}"
                          StrokeThickness="1.6" />
                    <Path x:Name="CupRight"
                          Data="{StaticResource HeadphoneCupRight}"
                          StrokeThickness="1.6" />
                </Canvas>

            </Grid>
        </Viewbox>
    </Grid>
</Window>
